{
  "name": "next-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:e2e": "CONTENT_SOURCE=fixtures FIXTURES_NOW=2026-10-26T18:00:00-04:00 next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "visual": "node tests/visual/build.mjs && playwright test -c tests/visual/playwright.config.ts",
    "migrate": "tsx scripts/migrate-wp/index.ts",
    "recap": "tsx scripts/recap/index.ts",
    "typegen": "SANITY_TELEMETRY_DISABLED=1 sanity schema extract --path schema.json --force && SANITY_TELEMETRY_DISABLED=1 sanity typegen generate",
    "team-photos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/team-photo-versions.ts",
    "tokens": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/tokens.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:e2e && npm run e2e",
    "visual:run": "playwright test -c tests/visual/playwright.config.ts"
  },
  "dependencies": {
    "@portabletext/react": "8.0.1",
    "@sanity/client": "8.14.1",
    "@sanity/image-url": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "groq-js": "2.0.1",
    "next": "16.4.5",
    "next-sanity": "13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.37.0",
    "sanitize-html": "2.18.1",
    "sanity": "6.22.0",
    "sharp": "0.35.5",
    "styled-components": "6.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@sanity/schema": "6.22.0",
    "@types/node": "20.19.43",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "node-html-parser": "9.0.5",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
