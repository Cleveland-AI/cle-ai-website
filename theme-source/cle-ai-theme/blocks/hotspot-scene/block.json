{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cle/hotspot-scene",
	"version": "1.1.0",
	"title": "Hotspot Scene",
	"category": "media",
	"icon": "location",
	"description": "An image with tappable markers that reveal short notes.",
	"textdomain": "cle-ai",
	"attributes": {
		"imageId": { "type": "number" },
		"imageAlt": { "type": "string", "default": "" },
		"heading": { "type": "string", "default": "" },
		"intro": { "type": "string", "default": "" },
		"markerStyle": { "type": "string", "enum": [ "numbered", "dot", "question", "icon" ], "default": "numbered" },
		"hotspots": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": { "type": "string" },
					"x": { "type": "number" },
					"y": { "type": "number" },
					"title": { "type": "string" },
					"body": { "type": "string" },
					"icon": { "type": "string" }
				}
			}
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": { "background": true, "text": true },
		"spacing": { "padding": true, "margin": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": [ "cle-hotspots", "file:./style.css" ],
	"render": "file:./render.php"
}
