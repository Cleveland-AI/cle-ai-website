{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cle/logo",
	"version": "1.0.0",
	"title": "Logo (animated)",
	"category": "theme",
	"icon": "marker",
	"description": "The four-dot logo drawn in CSS, linking home. The dots drop in on the first visit, jiggle on hover, and lean towards the pointer.",
	"textdomain": "cle-ai",
	"attributes": {
		"label": { "type": "string", "default": "CLE AI & DATA home" }
	},
	"supports": {
		"html": false,
		"spacing": { "margin": true }
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
