{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cle/menu",
	"version": "1.0.0",
	"title": "Menu (text links)",
	"category": "theme",
	"icon": "menu",
	"description": "Shows the menu assigned to a location in Appearance → Menus, as plain text links.",
	"textdomain": "cle-ai",
	"attributes": {
		"location": { "type": "string", "enum": [ "primary", "social" ], "default": "primary" },
		"label": { "type": "string", "default": "Main" }
	},
	"supports": {
		"html": false,
		"color": { "text": true, "link": true },
		"spacing": { "margin": true, "padding": true, "blockGap": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
