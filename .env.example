# Copy to .env.local for local work. In production these live in Vercel's Environment Variables.
# Never commit real values. See docs/switch-over.md.

# --- Sanity ---
# Sanity project id and dataset name (server side, scripts, recap command)
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Public copies of the two above, read by the Studio in the browser (not secret)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token; only a fallback for reading drafts in preview, never needed for public pages
SANITY_API_READ_TOKEN=
# Editor token: forms save submissions, the Meetup sync writes events, `npm run recap` saves drafts
SANITY_API_WRITE_TOKEN=
# Viewer token that can read drafts, for the Studio's live preview (/api/draft)
SANITY_API_DRAFTS_TOKEN=
# Shared secret for the Sanity publish webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# --- Forms (Resend and Cloudflare Turnstile) ---
# Resend API key for the form emails
RESEND_API_KEY=
# Where form submissions are emailed
FORMS_TO=info@cle-ai.com
# Sender address; defaults to: CLE AI & DATA <forms@cle-ai.com>. Its domain must be verified in Resend.
FORMS_FROM=
# Public: read by the form in the browser (not secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile secret key (server side)
TURNSTILE_SECRET_KEY=
# Hosts allowed to pass the spam check, comma-separated. Defaults to cle-ai.com,www.cle-ai.com;
# Vercel preview hosts must be listed here to test the forms there.
TURNSTILE_HOSTNAMES=

# --- Meetup sync ---
# Meetup OAuth consumer key and secret
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=
# First refresh token only; after the first sync the rotated token is kept in Sanity and wins over this
MEETUP_REFRESH_TOKEN=
# The Meetup group's URL name
MEETUP_GROUP_URLNAME=cleveland-ai-data
# Secret Vercel Cron sends as a Bearer token to /api/cron/meetup-sync (Vercel supplies it when set)
CRON_SECRET=

# --- WordPress migration (npm run migrate; local use only, not needed on Vercel) ---
# Base URL of the live WordPress site
WP_BASE=
# WordPress user and application password for the REST API
WP_APP_USER=
WP_APP_PASSWORD=

# --- Site ---
# The site's public origin (canonicals, sitemap, feed). Defaults to https://cle-ai.com
NEXT_PUBLIC_SITE_URL=
# sanity | fixtures. "fixtures" reads tests/fixtures/dataset.ndjson and is for tests and local work only;
# never set it on Vercel (production must be "sanity").
CONTENT_SOURCE=sanity
# Set to "enforce" to enforce the full Content-Security-Policy; empty sends it as Report-Only (see docs/switch-over.md)
CSP_MODE=
# Fixtures mode only: pin "now" to an ISO time so date tests are stable
FIXTURES_NOW=
# Fixtures mode only: path to a different fixtures file
FIXTURES_PATH=
# Build output folder override used by the test runs; leave empty
NEXT_DIST_DIR=
